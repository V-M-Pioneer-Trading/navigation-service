    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "health-controller"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Market": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "exchange": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TradeGood"
            }
          },
          "exports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TradeGood"
            }
          },
          "imports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TradeGood"
            }
          },
          "symbol": {
            "type": "string"
          },
          "tradeGoods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MarketTradeGood"
            }
          }
        },
        "required": [
          "symbol"
        ]
      },
      "MarketTradeGood": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "activity": {
            "type": "string"
          },
          "purchasePrice": {
            "type": "integer",
            "format": "int32"
          },
          "sellPrice": {
            "type": "integer",
            "format": "int32"
          },
          "supply": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "tradeVolume": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "purchasePrice",
          "sellPrice",
          "symbol"
        ]
      },
      "Shipyard": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "modificationsFee": {
            "type": "integer",
            "format": "int32"
          },
          "shipTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipyardShipType"
            }
          },
          "ships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipyardShip"
            }
          },
          "symbol": {
            "type": "string"
          }
        }
      },
      "ShipyardShip": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "activity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purchasePrice": {
            "type": "integer",
            "format": "int32"
          },
          "supply": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "purchasePrice",
          "type"
        ]
      },
      "ShipyardShipType": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      },
      "SystemWaypointsResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Waypoint"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "data",
          "total"
        ]
      },
      "TradeGood": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        }
      },
      "Waypoint": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "isUnderConstruction": {
            "type": "boolean"
          },
          "orbits": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "systemSymbol": {
            "type": "string"
          },
          "traits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WaypointTrait"
            }
          },
          "type": {
            "type": "string"
          },
          "x": {
            "type": "integer",
            "format": "int32"
          },
          "y": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "symbol",
          "traits",
          "type",
          "x",
          "y"
        ]
      },
      "WaypointTrait": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        },
        "required": [
          "symbol"
        ]
      }
    }
  }
}
