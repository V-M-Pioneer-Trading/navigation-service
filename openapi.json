        "parameters": [
          {
            "description": "Waypoint symbol, e.g. X1-FQ86-B29",
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Bypass cache and re-fetch from SpaceTraders",
            "in": "query",
            "name": "forceRefresh",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Market"
                }
              }
            },
            "description": "Market data"
          },
          "400": {
            "description": "Malformed waypoint symbol"
          },
          "401": {
            "description": "Not cached and caller is anonymous, or auth-service says a presented token is not active"
          },
          "404": {
            "description": "Waypoint has no marketplace"
          },
          "4XX": {
            "description": "Any other status st-gateway sent, relayed with its own message and its Retry-After / X-RateLimit-* headers - 429 when the shared rate budget is spent, 401 when the injected agent token was rejected"
          },
          "502": {
            "description": "st-gateway answered with something unreadable"
          },
          "503": {
            "description": "auth-service could not verify a presented token (`the authentication service could not process this request`), or relayed from st-gateway: no SpaceTraders credential configured"
          },
          "504": {
            "description": "st-gateway did not answer"
          }
        },
        "summary": "Get market data for a waypoint",
        "tags": [
          "Market"
        ]
      }
    },
    "/api/navigation/v1/waypoints/{symbol}/market/refresh": {
      "post": {
        "description": "Force-fetches market data from SpaceTraders and updates the local cache.",
        "operationId": "refreshMarket",
        "parameters": [
          {
            "description": "Waypoint symbol, e.g. X1-FQ86-B29",
            "in": "path",
            "name": "symbol",
            "required": true,
