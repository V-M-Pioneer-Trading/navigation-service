{
  "openapi": "3.0.1",
  "info": {
    "description": "Read-through cache for SpaceTraders waypoint, market and shipyard data",
    "title": "navigation-service",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "Market lookup and cache management",
      "name": "Market"
    },
    {
      "description": "Shipyard lookup and cache management",
      "name": "Shipyard"
    },
    {
      "description": "Waypoint lookup and cache management",
      "name": "Waypoints"
    }
  ],
  "paths": {
    "/api/navigation/health": {
      "get": {
        "operationId": "health_1",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "health-controller"
        ]
      }
    },
    "/api/navigation/v1/systems/{systemSymbol}/waypoints": {
      "get": {
        "description": "Returns all waypoints for a system. Serves from local cache only once a complete walk of the system has been cached; otherwise fetches every page from SpaceTraders. Use `forceRefresh=true` to re-walk the system.",
        "operationId": "getWaypointsBySystem",
        "parameters": [
          {
            "description": "System symbol, e.g. X1-FQ86",
            "in": "path",
            "name": "systemSymbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Bypass cache and re-fetch all waypoints for the system",
            "in": "query",
            "name": "forceRefresh",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemWaypointsResponse"
                }
              }
            },
            "description": "List of waypoints"
          },
          "400": {
            "description": "Malformed system symbol"
          },
          "401": {
            "description": "Not cached and caller is anonymous, or auth-service says a presented token is not active"
          },
          "404": {
            "description": "System not found"
          },
          "4XX": {
            "description": "Any other status st-gateway sent, relayed with its own message and its Retry-After / X-RateLimit-* headers - 429 when the shared rate budget is spent, 401 when the injected agent token was rejected"
          },
          "502": {
            "description": "st-gateway answered with something unreadable"
          },
          "503": {
            "description": "auth-service could not verify a presented token (`the authentication service could not process this request`), or relayed from st-gateway: no SpaceTraders credential configured"
          },
          "504": {
            "description": "st-gateway did not answer"
          }
        },
        "summary": "List waypoints by system",
        "tags": [
          "Waypoints"
        ]
      }
    },
    "/api/navigation/v1/systems/{systemSymbol}/waypoints/refresh": {
      "post": {
        "description": "Force-fetches all waypoints for a system from SpaceTraders and replaces the local cache.",
        "operationId": "refreshWaypointsBySystem",
        "parameters": [
          {
            "description": "System symbol, e.g. X1-FQ86",
            "in": "path",
            "name": "systemSymbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemWaypointsResponse"
                }
              }
            },
            "description": "Updated list of waypoints"
          },
          "400": {
            "description": "Malformed system symbol"
          },
          "401": {
            "description": "No bearer token, or auth-service says the presented one is not active"
          },
          "403": {
            "description": "A verified session without the universe:refresh scope"
          },
          "4XX": {
            "description": "Any other status st-gateway sent, relayed with its own message and its Retry-After / X-RateLimit-* headers - 429 when the shared rate budget is spent, 401 when the injected agent token was rejected"
          },
          "502": {
            "description": "st-gateway answered with something unreadable"
          },
          "503": {
            "description": "auth-service could not verify a presented token (`the authentication service could not process this request`), or relayed from st-gateway: no SpaceTraders credential configured"
          },
          "504": {
            "description": "st-gateway did not answer"
          }
        },
        "summary": "Refresh all waypoints for a system",
        "tags": [
          "Waypoints"
        ]
      }
    },
    "/api/navigation/v1/waypoints/{symbol}": {
      "get": {
        "description": "Returns a waypoint. Serves from local cache if available; fetches from SpaceTraders on first miss. Use `forceRefresh=true` to bypass the cache.",
        "operationId": "getWaypoint",
        "parameters": [
          {
            "description": "Waypoint symbol, e.g. X1-FQ86-B29",
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Bypass cache and re-fetch from SpaceTraders",
            "in": "query",
            "name": "forceRefresh",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Waypoint"
                }
              }
            },
            "description": "Waypoint data"
          },
          "400": {
            "description": "Malformed waypoint symbol"
          },
          "401": {
            "description": "Not cached and caller is anonymous, or auth-service says a presented token is not active"
          },
          "404": {
            "description": "Waypoint not found in SpaceTraders"
          },
          "4XX": {
            "description": "Any other status st-gateway sent, relayed with its own message and its Retry-After / X-RateLimit-* headers - 429 when the shared rate budget is spent, 401 when the injected agent token was rejected"
          },
          "502": {
            "description": "st-gateway answered with something unreadable"
          },
          "503": {
            "description": "auth-service could not verify a presented token (`the authentication service could not process this request`), or relayed from st-gateway: no SpaceTraders credential configured"
          },
          "504": {
            "description": "st-gateway did not answer"
          }
        },
        "summary": "Get waypoint by symbol",
        "tags": [
          "Waypoints"
        ]
      }
    },
    "/api/navigation/v1/waypoints/{symbol}/market": {
      "get": {
        "description": "Returns market data (imports/exports/exchange, prices). Serves from local cache if fetched within the last 60 seconds; fetches fresh from SpaceTraders otherwise. Use `forceRefresh=true` to always bypass the cache.",
